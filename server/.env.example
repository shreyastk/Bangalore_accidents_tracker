# Supabase project API settings
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Supabase Dashboard > Connect > Transaction pooler (recommended for hosted API)
# Keep this server-only. Never put it in Frontend/js/bat-config.js.
SUPABASE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

PORT=3000
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:5173
ADMIN_SLUG=choose-a-private-management-slug
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
OPENROUTER_VISION_MODEL=openrouter/free